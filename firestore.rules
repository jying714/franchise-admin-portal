rules_version = '2';

// P2 Final Hardened Rules - Tier 4
// Reviewed against full_firestore_schema + all customer flows in shared_core FirestoreServiceImpl
// Covers: loyalty, favorites (franchise_profiles), scheduledOrders, support_chats, promotions, franchise config, per-franchise users
// Preserves collectionGroup for feedback (hasOrderFeedback) and any remaining cross-tenant admin patterns
// All customer data strictly prefers franchises/{franchiseId}/...

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAnyRole(roles) {
      return isSignedIn() &&
             request.auth.token.roles is list &&
             request.auth.token.roles.hasAny(roles);
    }

    function isHqOwner() {
      return hasAnyRole(['hq_owner', 'platform_owner', 'developer']);
    }

    // Portal managers: membership lives on users/{uid}, not only custom claims.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userHasFranchise(franchiseId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().keys().hasAny(['franchiseIds'])
        && userDoc().franchiseIds is list
        && userDoc().franchiseIds.hasAny([franchiseId]);
    }

    function isFranchiseOwner(franchiseId) {
      return isHqOwner()
        || request.auth.token.defaultFranchise == franchiseId
        || (request.auth.token.franchiseIds is list
            && request.auth.token.franchiseIds.hasAny([franchiseId]))
        || userHasFranchise(franchiseId);
    }

    function isPosStation(franchiseId) {
      return isSignedIn() &&
             request.auth.token.stationFranchise == franchiseId;
    }

    // === PUBLIC CUSTOMER READS ===
    match /{path=**}/menu_items/{doc} {
      allow read: if true;
    }
    match /{path=**}/categories/{doc} {
      allow read: if true;
    }
    match /{path=**}/ingredient_metadata/{doc} {
      allow read: if true;
    }
    match /{path=**}/ingredient_types/{doc} {
      allow read: if true;
    }
    match /{path=**}/banners/{doc} {
      allow read: if true;
    }
    match /platform_features/{doc} {
      allow read: if true;
    }

    // === USERS ===
    match /users/{userId} {
      allow read: if request.auth.uid == userId
                  || isHqOwner()
                  || (
                       resource.data.franchiseIds is list
                       && isSignedIn()
                       && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                       && userDoc().keys().hasAny(['franchiseIds'])
                       && userDoc().franchiseIds is list
                       && resource.data.franchiseIds.hasAny(userDoc().franchiseIds)
                     );
      allow create: if request.auth.uid == userId || isHqOwner();
      allow update: if request.auth.uid == userId
                    || isHqOwner()
                    || (
                         resource.data.franchiseIds is list
                         && (
                              (request.auth.token.franchiseIds is list
                               && resource.data.franchiseIds.hasAny(
                                    request.auth.token.franchiseIds))
                              || userHasFranchise(
                                   resource.data.franchiseIds[0])
                            )
                       );
      allow delete: if isHqOwner();

    match /franchise_profiles/{franchiseId} {
      allow read, write: if request.auth.uid == userId || isHqOwner();
    }

    // Customer delivery addresses: users/{uid}/addresses/{addressId}
    match /addresses/{addressId} {
      allow read, write: if request.auth.uid == userId || isHqOwner();
    }

    // Optional — only if these paths are used client-side
    match /favorite_orders/{orderId} {
      allow read, write: if request.auth.uid == userId || isHqOwner();
      }
    }

    // === FRANCHISE DATA ===
    match /franchises/{franchiseId} {
    	allow read: if resource.data.get('listedInDirectory', false) == true
                || isHqOwner()
                || isFranchiseOwner(franchiseId);
      allow write: if isHqOwner();

    // Existing one-level subcollections (menu_items, categories, etc.)
    match /{collection}/{doc} {
      allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId);
    }

    // Nested user profiles under the franchise (the path that is failing)
    match /users/{userId} {
      allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId)
                        || request.auth.uid == userId;

      match /franchise_profiles/{profileId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId)
                          || request.auth.uid == userId;
      }
    }

      // Onboarding progress: franchises/{id}/onboarding_progress/progress
      match /onboarding_progress/{docId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId);
      }

      // === POS station (Decision 14) ===
      // Nested config docs (one-level {collection}/{doc} does not cover these).
            // Public read for storefront/customer/POS display config.
      // Write remains HQ / franchise owner only.
      match /config/{configDocId} {
        allow read: if configDocId in [
              'store_ops',
              'storefront',
              'ui_config',
              'features',
              'pos'
            ]
            || isHqOwner()
            || isFranchiseOwner(franchiseId)
            || isPosStation(franchiseId);
        allow write: if isHqOwner() || isFranchiseOwner(franchiseId);
      }

      // Explicit POS collections (same gate as generic one-level match;
      // listed for clarity + future station-claim tightening).
      // POS staff: managers keep full access; station may get a single doc
      // when signed in and posEnabled (PIN verify client-side).
      // Do not allow list for random signed-in customers.
      match /staff/{staffId} {
        // POS must list to match PIN client-side; station claim scoped to franchise.
        allow get, list: if isHqOwner() || isFranchiseOwner(franchiseId) ||
          isPosStation(franchiseId);
        allow create, update, delete: if isHqOwner() || isFranchiseOwner(franchiseId);
      }
      match /time_entries/{entryId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId) ||
          isPosStation(franchiseId);
      }
      match /shifts/{shiftId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId);
      }
      match /drivers/{driverId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId);
      }
      match /waitresses/{waitressId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId);
      }
      match /print_jobs/{jobId} {
        allow read, write: if isHqOwner() || isFranchiseOwner(franchiseId);
      }
      match /orders/{orderId} {
        allow read: if isHqOwner() || isFranchiseOwner(franchiseId) || isPosStation(franchiseId);
        allow write: if isHqOwner() || isFranchiseOwner(franchiseId) || isPosStation(franchiseId);
      }
    }

    // === AUDIT & ERROR LOGS ===
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read, write: if isHqOwner();
    }
    match /error_logs/{docId} {
      allow create: if isSignedIn();
      allow read, write: if isHqOwner();
    }
    match /public_error_logs/{docId} {
      allow create: if isSignedIn();
      allow read, write: if isHqOwner();
    }
    

    // === PLATFORM LEVEL ===
    match /platform_plans/{planId} {
      allow read: if isHqOwner();
    }
    match /platform_invoices/{invId} {
      allow read, write: if isHqOwner();
    }
    match /payouts/{payoutId} {
      allow read, write: if isHqOwner();
    }
    match /franchise_subscriptions/{subId} {
      allow read, write: if isHqOwner();
    }

    // === FRANCHISEE INVITATIONS (top-level collection) ===
    // Client list/stream/update/cancel from Platform Owner / HQ / Developer.
    // Creates are performed by Cloud Function (Admin SDK) and bypass rules.
    match /franchisee_invitations/{invitationId} {
  // Token == doc id; unguessable link. Needed so accept page can load while signed out.
  allow get: if true;
  allow list: if isHqOwner();

  allow create: if isHqOwner()
                && request.resource.data.keys().hasAll([
                     'email', 'status', 'token', 'franchiseId'
                   ])
                && request.resource.data.status == 'pending'
                && request.resource.data.inviteType == 'portal_staff';

  allow update: if isHqOwner()
                || (isSignedIn()
                    && resource.data.email is string
                    && resource.data.email == request.auth.token.email
                    && resource.data.status == 'pending'
                    && request.resource.data.status == 'accepted');

  allow delete: if isHqOwner();
}

    // === ALERTS ===
    match /alerts/{doc} {
      allow read, write: if isHqOwner() ||
        (request.resource.data.franchiseId == null ||
         isFranchiseOwner(request.resource.data.franchiseId));
    }

    // Deny everything else (including top-level onboarding_progress/{id})
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
