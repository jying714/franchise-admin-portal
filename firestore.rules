rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function hasAnyRole(roles) {
      return isSignedIn() && 
             request.auth.token.roles is list && 
             request.auth.token.roles.hasAny(roles);
    }
    function isOwnerOfUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Public reads
    match /{path=**}/menu_items/{doc} { allow read: if true; }
    match /{path=**}/categories/{doc} { allow read: if true; }
    match /{path=**}/banners/{doc} { allow read: if true; }
    match /{path=**}/ingredient_metadata/{doc} { allow read: if true; }
    match /{path=**}/ingredient_types/{doc} { allow read: if true; }

    // Users + Franchise Profiles (Favorites)
    match /users/{userId} {
      allow read, write: if isOwnerOfUser(userId) || hasAnyRole(['platform_owner', 'developer', 'hq_owner', 'manager']);

      match /franchise_profiles/{franchiseId} {
        allow read, write: if isOwnerOfUser(userId) || hasAnyRole(['platform_owner', 'developer', 'hq_owner', 'manager']);
      }
    }

    // Carts
    match /franchises/{franchiseId}/carts/{userId} {
      allow read, write: if isOwnerOfUser(userId);
    }

    // Orders + Feedback (critical for Order History)
    match /franchises/{franchiseId}/orders/{orderId} {
      allow create, read, update: if isOwnerOfUser(request.resource.data.userId) ||
                                     request.auth.uid == resource.data.userId ||
                                     hasAnyRole(['platform_owner', 'developer', 'manager', 'hq_owner']);
    }

    // Allow collection group queries for feedback (needed for hasOrderFeedback checks)
    match /{path=**}/feedback/{feedbackId} {
      allow read: if isSignedIn();   // Users can read their own feedback
      allow create, update: if isSignedIn();
    }

    // Admin / Platform paths
    match /onboarding_progress/{franchiseId} { allow read, write: if hasAnyRole(['platform_owner', 'developer', 'hq_owner']); }
    match /franchise_subscriptions/{subId} { allow read: if hasAnyRole(['platform_owner', 'developer', 'hq_owner', 'manager']); }
    match /audit_logs/{logId} { allow read, write: if hasAnyRole(['platform_owner', 'developer']); }
    match /error_logs/{docId} { allow create: if isSignedIn(); allow read, write: if hasAnyRole(['platform_owner', 'developer']); }

    // Deny everything else
    match /{document=**} { allow read, write: if false; }
  }
}